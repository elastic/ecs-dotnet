<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net10.0</TargetFrameworks>
    <Title>Elastic APM NLog Layout Renderers</Title>
    <Description>Enrich NLog log messages with APM TraceId and TransactionId.</Description>
    <IsPackable>True</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="Elastic.Apm" Version="1.34.1" />
  </ItemGroup>
</Project>
